# Formatting only; the compiler contract is meson.build and the
# compile_commands.json it produces.
#
# Include order encodes invariant 4 — the two permitted header sources — plus
# the bucket libuc itself adds: the headers it installs. In order of how far
# they are from us:
#
#   0  this file's own header, so a header that is not self-contained fails here
#   1  compiler-provided freestanding headers (the only C library above us)
#   2  the pinned kernel's uapi
#   3  anything else in <>, which under -nostdlibinc should not compile at all
#   4  the headers libuc installs, as their consumers spell them — <string.h>
#      and <sys/auxv.h> here are bucket "ours", not bucket "should not compile"
#   5  project-private headers in ""
#
# Regroup rather than Preserve so the grouping is enforced and reformatted
# rather than merely tolerated. Categories are enumerated instead of matched by
# prefix so that <stdio.h> lands in bucket 3 and looks wrong, rather than
# blending into bucket 1 — and a header libuc does not ship yet lands there
# too, instead of passing as already ours.
BasedOnStyle: LLVM
SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<(stdint|stddef|stdarg|stdatomic|stdckdint|stdalign|limits|float|iso646)\.h>$'
    Priority: 1
  - Regex: '^<(asm|asm-generic|linux)/'
    Priority: 2
  - Regex: '^<(errno|fcntl|netinet/in|string|sys/auxv|sys/socket|sys/types|unistd)\.h>$'
    Priority: 4
  - Regex: '^<'
    Priority: 3
  - Regex: '^"'
    Priority: 5
