# Formatting only; the compiler contract is compile_commands.json, generated by
# the Makefile so the editor and the build cannot drift.
#
# Include order encodes invariant 4 — the two permitted header sources, in
# order of how far they are from us:
#
#   0  this file's own header, so a header that is not self-contained fails here
#   1  compiler-provided freestanding headers (the only C library we have)
#   2  the pinned kernel's uapi
#   3  anything else in <>, which under -nostdlibinc should not compile at all
#   4  project headers
#
# Regroup rather than Preserve so the grouping is enforced and reformatted
# rather than merely tolerated. Categories are enumerated instead of matched by
# prefix so that <stdio.h> lands in bucket 3 and looks wrong, rather than
# blending into bucket 1.
BasedOnStyle: LLVM
SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<(stdint|stddef|stdarg|stdatomic|stdckdint|stdalign|limits|float|iso646)\.h>$'
    Priority: 1
  - Regex: '^<(asm|asm-generic|linux)/'
    Priority: 2
  - Regex: '^<'
    Priority: 3
  - Regex: '^"'
    Priority: 4
