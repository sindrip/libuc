# Merged over tinyconfig + kernel/configs/kvm_guest.config.
# kvm_guest brings NET/INET, PCI, TTY and the virtio devices; virtio-net is
# what select-s PAGE_POOL, which IO_URING_ZCRX depends on.

# EXPERT unhides IO_URING_MOCK_FILE, which is default n.
CONFIG_EXPERT=y
CONFIG_IO_URING=y
CONFIG_IO_URING_MOCK_FILE=y

# IO_URING_BPF wants BPF; IO_URING_BPF_OPS additionally wants BTF, which is
# what drags full debug info into an otherwise tiny build.
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_DEBUG_INFO_BTF=y

# Enough platform to come up under VZ and say so.
CONFIG_PRINTK=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_VIRTIO_MMIO=y
